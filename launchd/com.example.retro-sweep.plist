<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly retro sweep, Saturday 09:00. Replace YOUR_USER, copy to ~/Library/LaunchAgents/,
     then: launchctl load ~/Library/LaunchAgents/com.example.retro-sweep.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.retro-sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/YOUR_USER/bin/retro-sweep.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>6</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardErrorPath</key><string>/tmp/retro-sweep.err</string>
</dict>
</plist>
